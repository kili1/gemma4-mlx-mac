# Optional defaults for local development and runtime configuration.
GEMMA4_MLX_MODEL=mlx-community/gemma-4-E2B-it-qat-4bit
GEMMA4_MLX_HOST=127.0.0.1
GEMMA4_MLX_PORT=8080
# Optional: persist custom model download locations here (defaults to ~/.cache/gemma4-mlx-mac/state.json).
# GEMMA4_MLX_STATE_FILE=~/.cache/gemma4-mlx-mac/state.json
# Optional: Hugging Face token for gated models (preferred over passing --token on the CLI).
# HF_TOKEN=
